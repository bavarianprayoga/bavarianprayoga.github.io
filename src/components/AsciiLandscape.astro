---
import Ascii from 'ascii.rest/astro';
import alpineDawn from 'ascii.rest/pieces/alpine-dawn';

// The Astro component reserves space for coloured scenes, but doesn't SSR their
// canvas. Keep a library-generated first frame underneath for no/failed JS.
const still = alpineDawn()(0);
---

<div class="landscape" aria-hidden="true" inert>
    <div class="landscape-stage">
        <pre class="landscape-still">{still}</pre>
        <Ascii piece="alpine-dawn" fps={12} class="landscape-live" />
    </div>
</div>

<script>
    import { isPiece, load } from 'ascii.rest';

    const scene = document.querySelector('ascii-art.landscape-live');
    const toggle = document.getElementById('scene-toggle');
    const picker = document.getElementById('scene-picker');
    const choice = document.getElementById('scene-choice');
    const feedback = document.getElementById('scene-feedback');
    const caption = document.getElementById('scene-name');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sceneNames = choice instanceof HTMLSelectElement
        ? Array.from(choice.options).map((option) => option.value).filter(isPiece)
        : [];
    let paused = reducedMotion.matches;
    let currentScene = 'alpine-dawn';
    let selectedScene = 'alpine-dawn';
    let sceneRequest = 0;
    let rotationRequest = 0;
    let randomTimer: number | undefined;
    let previousFrame: HTMLCanvasElement | undefined;
    let frozenFrame: HTMLCanvasElement | undefined;
    let paintFrame: number | undefined;

    function clearPreviousFrame() {
        if (paintFrame !== undefined) cancelAnimationFrame(paintFrame);
        paintFrame = undefined;
        previousFrame?.remove();
        previousFrame = undefined;
    }

    function freezeCurrentFrame() {
        const canvas = scene?.querySelector('canvas');
        if (!canvas?.width || !canvas.height) return;
        const snapshot = document.createElement('canvas');
        snapshot.width = canvas.width;
        snapshot.height = canvas.height;
        const context = snapshot.getContext('2d');
        if (!context) return;
        context.drawImage(canvas, 0, 0);
        snapshot.className = 'landscape-frozen';
        frozenFrame?.remove();
        scene?.after(snapshot);
        frozenFrame = snapshot;
        // Moving the original offscreen invokes the library's visibility
        // pause without remounting it or resetting its animation clock.
        scene?.classList.add('landscape-paused');
    }

    function capturePreviousFrame() {
        const canvas = frozenFrame ?? scene?.querySelector('canvas');
        if (!canvas?.width || reducedMotion.matches) {
            clearPreviousFrame();
            return;
        }
        const snapshot = document.createElement('canvas');
        snapshot.width = canvas.width;
        snapshot.height = canvas.height;
        const context = snapshot.getContext('2d');
        if (!context) return;
        context.drawImage(canvas, 0, 0);
        // Flatten the exact visible mix of old imagery, dark tiles and
        // revealed new imagery when a transition is interrupted.
        if (previousFrame) {
            context.drawImage(previousFrame, 0, 0, snapshot.width, snapshot.height);
        }
        clearPreviousFrame();
        snapshot.className = 'landscape-previous';
        scene?.after(snapshot);
        previousFrame = snapshot;
    }

    function paintPixels(snapshot: HTMLCanvasElement) {
        const context = snapshot.getContext('2d');
        if (!context) {
            clearPreviousFrame();
            return;
        }
        // Each 4 × 4 tile blacks out and reveals characters center-out.
        // Share the order and rounded cell edges instead of running an
        // animation or recomputing geometry for every character.
        const columns = 50;
        const rows = 25;
        const tileSize = 4;
        const burstDuration = 240;
        const center = (tileSize - 1) / 2;
        const characterOrder = Array.from({ length: tileSize * tileSize }, (_, index) => {
            const x = index % tileSize;
            const y = Math.floor(index / tileSize);
            return { x, y, distance: (x - center) ** 2 + (y - center) ** 2 };
        }).sort((a, b) => a.distance - b.distance);
        const xEdges = Array.from({ length: columns * tileSize + 1 }, (_, x) =>
            Math.round(x * snapshot.width / (columns * tileSize)));
        const yEdges = Array.from({ length: rows * tileSize + 1 }, (_, y) =>
            Math.round(y * snapshot.height / (rows * tileSize)));
        const tiles = Array.from({ length: columns * rows }, (_, index) => {
            const column = (index % columns) * tileSize;
            const row = Math.floor(index / columns) * tileSize;
            const left = xEdges[column];
            const top = yEdges[row];
            return {
                column,
                row,
                left,
                top,
                width: xEdges[column + tileSize] - left,
                height: yEdges[row + tileSize] - top,
                // Finish concealing by 550ms and revealing by 1500ms,
                // preserving the dark beat and total 1.6-second duration.
                concealAt: Math.random() * (550 - burstDuration),
                revealAt: 650 + Math.random() * (850 - burstDuration),
                concealed: 0,
                revealed: 0,
            };
        });
        context.fillStyle = '#090c18';
        let started: number | undefined;

        const paint = () => {
            if (previousFrame !== snapshot) return;
            // RAF's frame timestamp can precede a costly ASCII redraw in
            // another callback. Start the burst when this callback runs.
            const now = performance.now();
            started ??= now;
            const elapsed = now - started;
            for (const tile of tiles) {
                if (tile.revealed === characterOrder.length) continue;
                if (elapsed >= tile.revealAt) {
                    const progress = (elapsed - tile.revealAt) / burstDuration;
                    if (progress >= 1) {
                        // Skip missed reveal steps on slow/hidden frames too.
                        context.clearRect(tile.left, tile.top, tile.width, tile.height);
                        tile.revealed = characterOrder.length;
                        continue;
                    }
                    const count = Math.floor(progress * characterOrder.length);
                    while (tile.revealed < count) {
                        const character = characterOrder[tile.revealed++];
                        const x = tile.column + character.x;
                        const y = tile.row + character.y;
                        // Reveal the live new scene one whole ASCII cell at a time.
                        context.clearRect(xEdges[x], yEdges[y], xEdges[x + 1] - xEdges[x], yEdges[y + 1] - yEdges[y]);
                    }
                    continue;
                }
                if (elapsed < tile.concealAt || tile.concealed === characterOrder.length) continue;
                const progress = (elapsed - tile.concealAt) / burstDuration;
                if (progress >= 1) {
                    // Catch up in one draw if a slow/hidden frame skips the
                    // burst, rather than replaying missed character steps.
                    context.fillRect(tile.left, tile.top, tile.width, tile.height);
                    tile.concealed = characterOrder.length;
                    continue;
                }
                const count = Math.floor(progress * characterOrder.length);
                while (tile.concealed < count) {
                    const character = characterOrder[tile.concealed++];
                    const x = tile.column + character.x;
                    const y = tile.row + character.y;
                    context.fillRect(xEdges[x], yEdges[y], xEdges[x + 1] - xEdges[x], yEdges[y + 1] - yEdges[y]);
                }
            }
            if (elapsed < 1600) paintFrame = requestAnimationFrame(paint);
            else clearPreviousFrame();
        };

        paintFrame = requestAnimationFrame(paint);
    }

    // mount() paints the first frame synchronously before this notification.
    // Keep the outgoing image fully visible until that new canvas is ready.
    const renderer = new MutationObserver(() => {
        // Choosing a different scene while frozen displays its new still
        // frame, while the original renderer stays paused offscreen.
        if (paused) freezeCurrentFrame();
        if (!previousFrame || paintFrame !== undefined ||
            scene?.querySelector('canvas')?.getAttribute('aria-label') !== currentScene.replaceAll('-', ' ')) return;
        if (reducedMotion.matches) {
            clearPreviousFrame();
            return;
        }
        paintPixels(previousFrame);
    });

    function updateCaption() {
        if (!(choice instanceof HTMLSelectElement)) return;
        const name = Array.from(choice.options).find((option) => option.value === currentScene)?.textContent ?? 'Alpine Dawn';
        if (caption) caption.textContent = name;
        const shuffle = choice.querySelector('option[value="random"]');
        // The dropdown is also the scene caption, including during rotation.
        if (shuffle) shuffle.textContent = selectedScene === 'random' ? `${name} · Shuffle` : 'Shuffle';
        const label = choice.selectedOptions[0]?.textContent ?? name;
        picker?.style.setProperty('--scene-label-width', `${label.length}ch`);
        choice.title = selectedScene === 'random' ? `${name} · Shuffle every 30 seconds` : name;
    }

    function rememberChoice() {
        try {
            localStorage.setItem('portfolio-scene', selectedScene);
        } catch {
            // Scene switching also works when storage is unavailable.
        }
    }

    function randomScene() {
        const candidates = sceneNames.filter((name) => name !== currentScene);
        return candidates[Math.floor(Math.random() * candidates.length)] ?? currentScene;
    }

    function scheduleRandom() {
        const rotation = ++rotationRequest;
        window.clearTimeout(randomTimer);
        if (selectedScene !== 'random' || paused || document.hidden) return;
        randomTimer = window.setTimeout(async () => {
            await changeScene(randomScene(), true);
            // A pause, visibility change or new selection owns its own timer;
            // an older in-flight rotation must not replace that fresh countdown.
            if (rotation === rotationRequest) scheduleRandom();
        }, 30_000);
    }

    function selectScene(name: string) {
        if (name !== 'random' && !sceneNames.some((sceneName) => sceneName === name)) return;
        selectedScene = name;
        rememberChoice();
        updateCaption();
        scheduleRandom();
        void changeScene(name === 'random' ? randomScene() : name);
    }

    async function changeScene(name: string, automatic = false) {
        if (!(choice instanceof HTMLSelectElement) || !isPiece(name) ||
            !Array.from(choice.options).some((option) => option.value === name)) return;

        const request = ++sceneRequest;
        const rotation = rotationRequest;
        if (name === currentScene) {
            picker?.removeAttribute('aria-busy');
            if (feedback) feedback.textContent = '';
            return;
        }
        picker?.setAttribute('aria-busy', 'true');
        if (feedback && !automatic) feedback.textContent = 'Loading scene…';

        try {
            // Load before changing the tag: keep the current canvas if a chunk
            // fails. Only the latest choice wins when requests overlap.
            await load[name]();
            if (request !== sceneRequest) return;
            if (automatic && (rotation !== rotationRequest || paused || document.hidden || selectedScene !== 'random')) return;
            capturePreviousFrame();
            currentScene = name;
            scene?.setAttribute('piece', name);
            updateCaption();
            if (feedback) feedback.textContent = '';
        } catch {
            if (request !== sceneRequest || (automatic && rotation !== rotationRequest)) return;
            if (selectedScene !== 'random') {
                selectedScene = currentScene;
                choice.value = currentScene;
                rememberChoice();
            }
            updateCaption();
            if (feedback) feedback.textContent = 'Scene unavailable. Please try another.';
        } finally {
            if (request === sceneRequest) picker?.removeAttribute('aria-busy');
        }
    }

    function updateScene() {
        if (paused) {
            freezeCurrentFrame();
        } else {
            scene?.classList.remove('landscape-paused');
            frozenFrame?.remove();
            frozenFrame = undefined;
            // Only an explicit play under reduced motion needs an override.
            // Normal pause/resume must not change observed attributes: each
            // options/fps change would replace the canvas and start at t=0.
            if (reducedMotion.matches && scene?.getAttribute('options') !== '{"motion":true}') {
                scene?.setAttribute('options', '{"motion":true}');
            }
        }
        toggle?.setAttribute('aria-pressed', String(paused));
        toggle?.setAttribute('aria-label', paused ? 'Play landscape animation' : 'Pause landscape animation');
        if (toggle) toggle.textContent = paused ? '[resume]' : '[freeze]';
    }

    if (scene && toggle) {
        renderer.observe(scene, { childList: true });
        // Leave the animation control hidden if the library script never loads.
        customElements.whenDefined('ascii-art').then(() => {
            // The observer captures the first frame if it isn't ready yet.
            // Leave the library's reduced-motion handling intact on load.
            updateScene();
            toggle.hidden = false;
            if (choice instanceof HTMLSelectElement && picker) {
                picker.hidden = false;
                if (caption) caption.hidden = true;
                updateCaption();
                choice.addEventListener('change', () => selectScene(choice.value));
                try {
                    const saved = localStorage.getItem('portfolio-scene');
                    if (saved && Array.from(choice.options).some((option) => option.value === saved)) {
                        choice.value = saved;
                        selectScene(saved);
                    }
                } catch {
                    // Keep Alpine Dawn when preferences cannot be read.
                }
            }
        });

        toggle.addEventListener('click', () => {
            paused = !paused;
            updateScene();
            scheduleRandom();
        });

        reducedMotion.addEventListener('change', () => {
            paused = reducedMotion.matches;
            if (reducedMotion.matches) clearPreviousFrame();
            updateScene();
            scheduleRandom();
        });

        // No hidden-tab rotations or catch-up burst on returning to the page.
        document.addEventListener('visibilitychange', scheduleRandom);
        window.addEventListener('pagehide', () => {
            rotationRequest++;
            window.clearTimeout(randomTimer);
            clearPreviousFrame();
        });
        window.addEventListener('pageshow', scheduleRandom);
    }
</script>
